# ESP-IDF Build directory
build/

# Local configuration files (contains machine-specific paths)
sdkconfig
sdkconfig.old
sdkconfig.defaults.old

# Python & virtual environment data
venv/
.venv/
__pycache__/
*.py[cod]

# Component Manager & dependencies
managed_components/
dependencies.lock
.component_hash

# VS Code specific (Optional: keep if you want to share workspace settings)
.vscode/
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json

# Compilation database (generated by some IDEs/tools)
compile_commands.json

# Temporary files
*~
*.swp
